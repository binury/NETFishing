weight_max_lb = 5.0
display_scale_min = 0.8
display_scale_max = 1.25
display_scale_curve = 1.0
sell_value_min = 4
sell_value_max = 6
sell_value_curve = 1.0
display_texture = ExtResource("4_texture")
