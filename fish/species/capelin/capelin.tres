[ext_resource type="Script" path="res://fish/fish_availability.gd" id="3_availability"]

[sub_resource type="Resource" id="Availability"]
script = ExtResource("3_availability")
require_fog = true

[resource]
script = ExtResource("1_fish_data")
id = &"capelin"
