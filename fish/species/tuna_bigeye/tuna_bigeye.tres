weight_min_lb = 20.0
weight_max_lb = 120.0
display_scale_min = 1.2
display_scale_max = 2.2
display_scale_curve = 0.8
sell_value_min = 22
sell_value_max = 48
sell_value_curve = 0.8
display_texture = ExtResource("4_texture")
